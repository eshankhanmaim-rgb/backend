# =============================================================================
# Pruvate Auth Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# All secrets must be generated randomly; see docs/SETUP.md for commands.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (service account — backend only, never expose to clients)
# -----------------------------------------------------------------------------
# Option A: Inline JSON (single line, escape quotes)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Path to JSON file (mutually exclusive with Option A)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

FIREBASE_PROJECT_ID=prime-auth-69e92
FIREBASE_STORAGE_BUCKET=prime-auth-69e92.firebasestorage.app
FIREBASE_DATABASE_URL=https://prime-auth-69e92-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_AUTH_DOMAIN=prime-auth-69e92.firebaseapp.com
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=89012130458
FIREBASE_APP_ID=1:89012130458:web:29f8fee94f548853d98523
FIREBASE_MEASUREMENT_ID=G-PC0YQNKF6J

# -----------------------------------------------------------------------------
# JWT & Session Tokens
# -----------------------------------------------------------------------------
# 64 random bytes, base64-encoded:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Password Hashing (Argon2id)
# -----------------------------------------------------------------------------
# 32 random bytes, hex:  python -c "import secrets; print(secrets.token_hex(32))"
ARGON2_PEPPER=

# Argon2id parameters (defaults are suitable for a server)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Ed25519 Signing Keys (generated by backend/scripts/gen_keys.py)
# -----------------------------------------------------------------------------
# Private key — KEEP THIS SECRET. Used by the server to sign loader responses.
ED25519_PRIVATE_KEY_B64=

# Public key — embedded in the C++ binary. No need to keep secret.
ED25519_PUBLIC_KEY_B64=

# -----------------------------------------------------------------------------
# License Key Cryptography
# -----------------------------------------------------------------------------
# AES-256-GCM key for encrypting raw license keys at rest (admin reveal):
# 32 random bytes, hex:  python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_KEY_ENCRYPTION_KEY=

# HMAC-SHA256 key for the key_lookup field (lookup without storing plaintext):
# 32 random bytes, hex:  python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_KEY_HMAC_KEY=

# -----------------------------------------------------------------------------
# CORS & URLs
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com

APP_ENV=production
APP_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REDEEM=3/minute
RATE_LIMIT_HEARTBEAT=120/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# Max failed login attempts before progressive lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=300
LOCKOUT_DURATION_SECONDS=900

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA)
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
# Set to "0x4AAAAAAAA..." for testing (always passes in non-production)

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Pruvate

# Email token TTLs
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# Discord Webhooks
# -----------------------------------------------------------------------------
# Admin event webhook (bans, force logout, admin actions)
DISCORD_WEBHOOK_ADMIN=

# Key events webhook (generated, claimed)
DISCORD_WEBHOOK_KEYS=

# Suspicious activity webhook (HWID mismatch, anomalies)
DISCORD_WEBHOOK_SECURITY=

# -----------------------------------------------------------------------------
# Redis (optional — for distributed nonce store and rate limits)
# Leave empty to use in-memory stores (single instance only)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Loader App
# -----------------------------------------------------------------------------
# The public app identifier embedded in the loader binary
LOADER_APP_ID=pruvate_loader_v1

# Minimum accepted loader version (older builds get UPDATE_REQUIRED)
LOADER_MIN_VERSION=1.0.0

# Session settings
LOADER_SESSION_TTL_HOURS=24
LOADER_HEARTBEAT_INTERVAL_SECONDS=60
LOADER_HEARTBEAT_GRACE_MISSED=3

# -----------------------------------------------------------------------------
# Storage (Firebase Storage paths)
# -----------------------------------------------------------------------------
STORAGE_SCRIPTS_PREFIX=scripts/covers/
STORAGE_RELEASES_PREFIX=releases/

# Max script cover image size in bytes (2 MB)
SCRIPT_COVER_MAX_BYTES=2097152

# Max Lua code size in bytes (512 KB)
SCRIPT_CODE_MAX_BYTES=524288

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Request size limit
MAX_REQUEST_SIZE_MB=10

# Structured log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Secret for internal health check endpoint (optional)
HEALTH_TOKEN=
